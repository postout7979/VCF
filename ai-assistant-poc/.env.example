# ===== 공통 =====
# 컨테이너 이미지 태그: 반입 시점에 검증된 버전으로 고정하세요 (재현성).
VLLM_TAG=latest
OPENWEBUI_TAG=main
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8
PGVECTOR_IMAGE=pgvector/pgvector:pg16
OPS_SYNC_IMAGE=python:3.12-slim

WEBUI_PORT=3000
WEBUI_SECRET_KEY=change-me-long-random-string
WEBUI_ADMIN_EMAIL=admin@example.local
WEBUI_ADMIN_PASSWORD=change-me-now
POSTGRES_PASSWORD=change-me-too

# ===== 모델 파일 (./models 아래 디렉터리명) =====
LLM_DIR=Qwen3-30B-A3B-Instruct-2507-FP8
EMBED_DIR=bge-m3
RERANK_DIR=bge-reranker-v2-m3

# ===== LLM 서빙 (vLLM) =====
LLM_SERVED_NAME=vcf-llm
LLM_MAX_LEN=32768
LLM_GPU_UTIL=0.90
LLM_MAX_SEQS=16
LLM_TP=1

# ===== 임베딩 =====
EMBED_SERVED_NAME=bge-m3

# ===== RAG 튜닝 =====
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=8
RAG_TOP_K_RERANKER=4
RAG_RELEVANCE_THRESHOLD=0.1

# ===== 모델 프리셋 참고 =====
# 24~48GB GPU 1장 : Qwen3-30B-A3B-Instruct-2507-FP8 (기본) / gpt-oss-20b(16GB급)
# 80GB GPU 1장    : Qwen3-30B-A3B-Instruct-2507 (BF16) 또는 gpt-oss-120b
# 반드시 라이선스와 한국어 품질을 사내 질문셋으로 평가한 뒤 확정하세요.

# ===== VCF Operations 연동 (docker compose --profile ops up -d) =====
# 읽기 전용 역할의 전용 계정을 사용하세요. 비밀번호가 들어 있으므로 .env 권한은 600.
VCFOPS_URL=https://vcf-ops.example.local
VCFOPS_USERNAME=svc-ai-readonly
VCFOPS_PASSWORD=
# 로컬 계정이면 비워 두고, vIDM/AD 등 외부 인증 소스면 해당 소스명을 입력
VCFOPS_AUTH_SOURCE=
VCFOPS_VERIFY_TLS=true
# 사설 CA 인증서(PEM)를 ./certs/ 에 두고 컨테이너 경로로 지정
VCFOPS_CA_FILE=/certs/vcfops-ca.pem
VCFOPS_TIMEOUT_SEC=60

# --- 하이브리드: 색인(ops-sync)은 구조/속성만, 실시간 값은 도구(ops-tools)가 질의 시점에 조회 ---
# 색인 주기(분). 구조/속성은 느리게 변하므로 길게(기본 6시간).
OPS_SYNC_INTERVAL_MIN=360
# 색인 대상: inventory(구조/속성). 도구 없이 쓰는 차선책일 때만 summary,alerts 추가
OPS_COLLECT=inventory
# true 면 색인에 헬스/지표 같은 실시간 값도 포함 (재임베딩 비용 큼, 비권장)
OPS_INDEX_LIVE_VALUES=false
OPS_RESOURCE_KINDS=VirtualMachine,HostSystem,ClusterComputeResource,Datastore
# 사용 가능한 키는 `python3 scripts/ops_sync.py --discover VirtualMachine` 으로 확인
OPS_STAT_KEYS=cpu|usage_average,mem|usage_average   # OPS_INDEX_LIVE_VALUES=true 일 때만 사용
OPS_PROPERTY_KEYS=summary|runtime|powerState,config|hardware|num_Cpu,config|hardware|memoryKB,summary|parentCluster,summary|parentHost
OPS_MAX_RESOURCES_PER_KIND=2000
OPS_MAX_ALERTS=2000
OPS_CHUNK_ENTRIES=80

# --- 실시간 조회 도구 서버 (ops-tools) ---
# 도구가 노출하는 지표: 별칭=실제 stat key (LLM 에는 별칭 enum 만 보임). 키는 --discover 로 확인
OPS_TOOL_STATS=cpu_usage_pct=cpu|usage_average,mem_usage_pct=mem|usage_average
OPS_TOOL_PROPERTY_KEYS=summary|runtime|powerState,summary|parentCluster,summary|parentHost
OPS_TOOL_MAX_LIMIT=50
# VCF Operations 부하 제한용 응답 캐시 (수집 주기가 5분이므로 60초면 충분)
OPS_TOOL_CACHE_TTL_SEC=60
# Open WebUI <-> ops-tools Bearer 키. 반드시 임의의 긴 문자열로 변경
OPS_TOOLS_API_KEY=change-me-tools-key
# vLLM tool calling 파서 (Qwen3 Instruct: hermes. 모델 교체 시 해당 모델 문서의 파서로 변경)
LLM_TOOL_PARSER=hermes
