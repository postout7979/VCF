# ===== 공통 =====
# 컨테이너 이미지 태그: 반입 시점에 검증된 버전으로 고정하세요 (재현성).
VLLM_TAG=latest
OPENWEBUI_TAG=main
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8
PGVECTOR_IMAGE=pgvector/pgvector:pg16
OPS_SYNC_IMAGE=python:3.12-slim

WEBUI_PORT=3000
WEBUI_SECRET_KEY=change-me-long-random-string
WEBUI_ADMIN_EMAIL=admin@example.local
WEBUI_ADMIN_PASSWORD=change-me-now
POSTGRES_PASSWORD=change-me-too

# ===== 모델 파일 (./models 아래 디렉터리명) =====
LLM_DIR=Qwen3-30B-A3B-Instruct-2507-FP8
EMBED_DIR=bge-m3
RERANK_DIR=bge-reranker-v2-m3

# ===== LLM 서빙 (vLLM) =====
LLM_SERVED_NAME=vcf-llm
LLM_MAX_LEN=32768
LLM_GPU_UTIL=0.90
LLM_MAX_SEQS=16
LLM_TP=1

# ===== 임베딩 =====
EMBED_SERVED_NAME=bge-m3

# ===== RAG 튜닝 =====
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=8
RAG_TOP_K_RERANKER=4
RAG_RELEVANCE_THRESHOLD=0.1

# ===== 모델 프리셋 참고 =====
# 24~48GB GPU 1장 : Qwen3-30B-A3B-Instruct-2507-FP8 (기본) / gpt-oss-20b(16GB급)
# 80GB GPU 1장    : Qwen3-30B-A3B-Instruct-2507 (BF16) 또는 gpt-oss-120b
# 반드시 라이선스와 한국어 품질을 사내 질문셋으로 평가한 뒤 확정하세요.

# ===== VCF Operations 연동 (docker compose --profile ops up -d) =====
# 읽기 전용 역할의 전용 계정을 사용하세요. 비밀번호가 들어 있으므로 .env 권한은 600.
VCFOPS_URL=https://vcf-ops.example.local
VCFOPS_USERNAME=svc-ai-readonly
VCFOPS_PASSWORD=
# 로컬 계정이면 비워 두고, vIDM/AD 등 외부 인증 소스면 해당 소스명을 입력
VCFOPS_AUTH_SOURCE=
VCFOPS_VERIFY_TLS=true
# 사설 CA 인증서(PEM)를 ./certs/ 에 두고 컨테이너 경로로 지정
VCFOPS_CA_FILE=/certs/vcfops-ca.pem
VCFOPS_TIMEOUT_SEC=60

OPS_SYNC_INTERVAL_MIN=60
# summary(환경 요약), alerts(활성 알림), inventory(리소스 상태/지표)
OPS_COLLECT=summary,alerts,inventory
OPS_RESOURCE_KINDS=VirtualMachine,HostSystem,ClusterComputeResource,Datastore
# 사용 가능한 키는 `python3 scripts/ops_sync.py --discover VirtualMachine` 으로 확인
OPS_STAT_KEYS=cpu|usage_average,mem|usage_average
OPS_PROPERTY_KEYS=summary|runtime|powerState,config|hardware|num_Cpu,config|hardware|memoryKB
OPS_MAX_RESOURCES_PER_KIND=2000
OPS_MAX_ALERTS=2000
OPS_CHUNK_ENTRIES=80
